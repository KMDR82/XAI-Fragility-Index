<mxfile host="app.diagrams.net"><diagram name="Fig01" id="fig01"><mxGraphModel dx="1500" dy="600" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="480"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp" value="Image pairs: clean + 9 perturbed versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0efec;strokeColor=#9a9893;dashed=1;verticalAlign=top;fontSize=10;fontColor=#52514e;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="270" height="260" as="geometry"/></mxCell><mxCell id="in" value="&lt;b&gt;Chest radiograph&lt;/b&gt;&lt;br&gt;RSNA test set, 5,337 patients&lt;br&gt;224 &amp;#215; 224, grey value in 3 channels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="230" height="70" as="geometry"/></mxCell><mxCell id="pert" value="&lt;b&gt;Perturbation&lt;/b&gt;&lt;br&gt;seeded per patient and condition&lt;br&gt;Gaussian noise &amp;#963; = 0.1 / 0.2 / 0.3&lt;br&gt;Gaussian blur k = 3 / 5 / 7&lt;br&gt;Salt-and-pepper 1 / 2 / 3 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="230" height="110" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;Classifier (ResNet-50)&lt;/b&gt;&lt;br&gt;A: submitted model&lt;br&gt;A-rep: same recipe, retrained&lt;br&gt;A-norm: + ImageNet normalisation&lt;br&gt;B: ImageNet-pretrained, class-weighted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="230" height="120" as="geometry"/></mxCell><mxCell id="cam" value="&lt;b&gt;Explanations&lt;/b&gt;&lt;br&gt;for the class predicted on the clean image&lt;br&gt;Grad-CAM, Eigen-CAM&lt;br&gt;(Eigen-CAM sign-corrected: ablation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeee6;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="115" width="250" height="80" as="geometry"/></mxCell><mxCell id="pred" value="&lt;b&gt;Predicted class&lt;/b&gt;&lt;br&gt;clean vs perturbed image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="250" height="50" as="geometry"/></mxCell><mxCell id="base" value="&lt;b&gt;Baselines&lt;/b&gt;&lt;br&gt;pixel random, smooth random, cross-patient,&lt;br&gt;randomised model (layer4 + fc), uniform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="930" y="20" width="280" height="60" as="geometry"/></mxCell><mxCell id="xfi" value="&lt;b&gt;XFI&lt;/b&gt;&lt;br&gt;RS = [SSIM + (r&lt;sub&gt;P&lt;/sub&gt; + 1)/2 + (r&lt;sub&gt;S&lt;/sub&gt; + 1)/2] / 3&lt;br&gt;XFI = 1 &amp;#8722; RS, range [0, 4/3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="280" height="70" as="geometry"/></mxCell><mxCell id="loc" value="&lt;b&gt;Localization&lt;/b&gt; (positive patients)&lt;br&gt;IoU with radiologist box, clean / perturbed&lt;br&gt;background activation &amp;#8805; 0.5 / 0.7&lt;br&gt;energy outside the box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="930" y="230" width="280" height="80" as="geometry"/></mxCell><mxCell id="flip" value="&lt;b&gt;Prediction flip&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="280" height="50" as="geometry"/></mxCell><mxCell id="iq" value="&lt;b&gt;Input degradation&lt;/b&gt;&lt;br&gt;PSNR, SSIM (clean vs perturbed image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="230" height="50" as="geometry"/></mxCell><mxCell id="stat" value="&lt;b&gt;Statistics&lt;/b&gt;&lt;br&gt;patient = unit of analysis&lt;br&gt;&lt;br&gt;paired Wilcoxon + Holm&lt;br&gt;bootstrap 95 % CI&lt;br&gt;linear mixed model&lt;br&gt;(GEE check)&lt;br&gt;Spearman validity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0efec;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;arcSize=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="1270" y="20" width="200" height="430" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514e;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in" target="pert"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="140" as="sourcePoint"/><mxPoint x="155" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514e;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="grp" target="cls"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="180" as="sourcePoint"/><mxPoint x="330" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514e;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="grp" target="iq"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="300" as="sourcePoint"/><mxPoint x="155" y="400" as="targetPoint"/></mxGeometry></mxCell><